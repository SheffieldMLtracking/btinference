#!/usr/bin/env python
import argparse
import alignment
import alignment.helper
import numpy as np
from pathinference.particle import Smooth
import btinference
import os
import sys
import re
from pathlib import Path
import json
from btretrodetect.utils import get_cam_paths
import pickle


def totalsecs(st):
    time_hms = [int(s) for s in re.findall('([0-9]{1,2})[:+]([0-9]{2})[:+]([0-9]{2})',st)[0]]
    return time_hms[0]*3600 + time_hms[1]*60 + time_hms[2]
    
def getgreyscalepaths(calsetpath):
    greyscalecalsetpaths = []
    for p in calsetpath.glob('*'):
        #print(type(p),p)
        paths = get_cam_paths(p.as_posix())
        if True in paths:            
            greyscalecalsetpaths.append(Path(paths[True]))
    return list(set(greyscalecalsetpaths))
    
parser = argparse.ArgumentParser(description='Runs the 3d path inference algorithm for the bee-track project. This can either run a cross validation check, or can simply output the flight path.')
parser.add_argument('imgpath',type=str,help='Path to images (this needs to be to the *set* folder, e.g. 2024-06-20/CalibTest200624/conetag2')
parser.add_argument('--calset',required=False,type=str,help='Name of the alignment set (default = \'cal\'). This will look in a neighbouring folder to the set.',default='cal')
parser.add_argument('--xval',help='Setting this means the algorithm will just do a cross-validation check (and won\'t write to the config file).',action="store_true")
parser.add_argument('--interval_length',required=False,type=float,help='Only process images in this interval of time',default=300)
parser.add_argument('--interval_start',required=False,type=float,help='Only process images that were created from this time after the first tagged image',default=0)
parser.add_argument('--after',required=False,type=str,help='Only process images that were created after this time HH:MM:SS',default=None)
parser.add_argument('--before',required=False,type=str,help='Only process images that were created before this time HH:MM:SS',default=None)
parser.add_argument('--keepcolour',required=False, default=False, help="Tool tries to identify the cameras as colour/greyscale and only keeps greyscale. Setting this uses all the cameras",action="store_true")


parser.add_argument('--tagsource',help='The source(s) of labelled data (default:btviewer). Can pass a list, e.g. --tagsource btviewer btretrodetect_inference',type=str,nargs='+',default='btviewer')
parser.add_argument('--taglabel',help='The label id of the source data (default:none)',type=str,default='')
parser.add_argument('--alignmentsourcename',help='The source of alignment analysis (default:btalignment)',type=str,default='btalignment')
parser.add_argument('--sourcename',help='The name to give this source of labels (default:btinference)',type=str,default='btinference')
parser.add_argument('--particles',help='The number of particles (default:10000)',type=int,default=10000)
parser.add_argument('--likelihood_std',help='Standard deviation of the likelihood normal distribution (default 0.05m)',type=float,default=0.05)
parser.add_argument('--makeanimation',required=False, type=str, help="Make a top-down animation of the inference result (specify filename, e.g. test.mp4)",default=None)
#parser.add_argument('--fastcache',required=False, default=False, help="Whether to save/load a 100 second chunk of inference path (makes it fast to infer new path, if using pretrained model)",action="store_true")
parser.add_argument('--refreshfastcache',required=False, default=False, help="Runs with fastcache but refreshes the cache.",action="store_true")




#TODO: Might want to either; (a) overwrite, (b) skip, (c) append...
#parser.add_argument('--',help='Stops it overwriting previous labels from this source (default behaviour is to do overwrite)',action="store_true") 
args = parser.parse_args()

#if args.refreshfastcache:
#    args.fastcache = True

interval = args.interval_length
interval_start = args.interval_start
    
if args.taglabel!='':
    print("Tag Label Section not yet implemented")
    sys.exit()
taglabel = args.taglabel
datapath = args.imgpath
calset = args.calset
sourcename = args.sourcename
tagsource = args.tagsource
keepcolour = args.keepcolour
datapath = Path(datapath).resolve()
sessionpath = datapath.parent
calsetpath = sessionpath.joinpath(calset)
alignmentsourcename = args.alignmentsourcename
inference_cache_fn =Path(datapath,'pf_cache_start%0.0f_interval%0.0f.pkl' % (interval_start,interval))
print("Data path: %s" % datapath)
print("Session path: %s" % sessionpath)
print("Using as tag source(s): ",end="")
if type(tagsource)==str: 
    print(tagsource, end=", ")
else:
    [print(t,end=", ") for t in tagsource]
print("")

#print("DEBUG")
#print(obstimes[0]-3, totalsecs(args.after))
#print(obstimes[-1]+3, totalsecs(args.before))
if args.after is not None:
    after = totalsecs(args.after)
else:
    after = 0
    
if args.before is not None:
    before = totalsecs(args.before)
else:
    before = 10000000000000000000

if keepcolour:
    calsetpaths = list(calsetpath.glob('*/*'))
else:
    calsetpaths = getgreyscalepaths(calsetpath)
    
#load the tag datafiles (for relevant cameras)
tagsetpaths = list(datapath.glob('*/*'))

if keepcolour:
    tagsetpaths = list(datapath.glob('*/*'))
else:
    tagsetpaths = getgreyscalepaths(datapath)

#if not keepcolour:
#    alltagimgfiles = [sorted(p.glob('*.np')) for p in tagsetpaths]
#    print("Removing colour cameras from set")
#    greyscale = [alignment.helper.guesscamtypegetscore(imgfiles[0])<0.02 for imgfiles in alltagimgfiles]
#    tagsetpaths = [p for p,g in zip(tagsetpaths,greyscale) if g]



#Print information
print("Base path: %s" % datapath.as_posix())
print("Searched %s for calibration sets." % calsetpath.as_posix())
print("Using these calibration sets:")
for p in calsetpaths:
    print("  "+p.as_posix())
print("Tag set paths:")
for p in tagsetpaths:
    print("  "+p.as_posix())

#print("Using these calibration sets:")
#for p in calsetpaths:
#    print("  "+p)
#
#print("Using these tag sources:")
#for p in tagsetpaths:
#    print("  "+p.as_posix())
#print("--")
    
#Start analysis (camera positions, observations, paths)
cameras = btinference.getcameras(calsetpaths, alignmentsourcename)
if len(cameras)==0:
    print("Failed to find cameras")
    sys.exit()
print("Cameras:")
[print(camidst) for camidst in cameras]
obstimes, observations, obsfrom = btinference.getobservations(tagsetpaths,tagsource,cameras,after,before)
obsfrom=np.array(obsfrom)
print("First file in observations: %s" % obsfrom[np.argmin(obstimes)])
first_observation_time = np.min(obstimes)
print("")
print("Found %d observations." % len(observations))



if interval is not None:
    print("Restricting observations to specified interval:")
    print("   Interval: %0.1f-%0.1f seconds interval." % (interval_start,interval_start+interval))
    keep = (obstimes<first_observation_time+interval+interval_start+3) & (obstimes>first_observation_time+interval_start-3)
    print("   Observation times: %0.1f - %0.1f" % (np.min(obstimes),np.max(obstimes)))
    obstimes = obstimes[keep]
    observations = observations[keep]
    obsfrom = obsfrom[keep]
    print("   Keeping %d observations." % len(observations))
    #print(obsfrom)

    
    #fnsonly = sorted([str(fn).split('/')[-1] for fn in obsfrom])
    #if len(fnsonly)>0:    
    #    print("     spanning %s to %s." % (fnsonly[0],fnsonly[-1]))
    
if len(observations)==0:
    print("!! No observations found.")
    sys.exit()
    
    
print("Observations spanning:")
tmin,tmax = np.min(obstimes),np.max(obstimes)
print("%02d:%02d:%05.2f" % (tmin//3600,(tmin%3600)//60,tmin%60))
print("%02d:%02d:%05.2f" % (tmax//3600,(tmax%3600)//60,tmax%60))    



#print("Observations from time (seconds) %d to %d" % (np.min(obstimes),np.max(obstimes)))
print("\nInferring flight path...")


lims = [[-2,12],[-2,12],[-5,5]]

pathi = None
if not args.refreshfastcache:
    try:
        inference_cache = pickle.load(open(inference_cache_fn,"rb"))

        print("Loaded Inference Cache")
        if not args.optimisemore:
            cache_obsfrom = inference_cache['obsfrom']
            #Have we already run inference on this set of files?
            list_of_filenames_cache = sorted([str(fn).split('/')[-1] for fn in cache_obsfrom])
            list_of_filenames_current = sorted([str(fn).split('/')[-1] for fn in obsfrom])
            #print(list_of_filenames_cache[:4],list_of_filenames_current[:4])
            if list_of_filenames_cache == list_of_filenames_current:
                print("Inference for this set already cached and run, exiting.")
                sys.exit()

        
        times = inference_cache['times']
        means = inference_cache['means']
        covs = inference_cache['covs']

        pathi = PathInference(obstimes, observations, lims, times, means, covs)
    except Exception as e:
        print("Unable to load inference cache:")
        print(e)
if pathi is None:
    pathi = Smooth(obstimes,observations,lims,Nparticles=args.particles,likelihood_std=args.likelihood_std)
    print("Running Inference")
    pathi.run()

#pickle.dump({'obsfrom':obsfrom,'logprobs':pathi.last_logprobs.numpy().astype(float)},open(Path(datapath,'last_logprobs.pkl'),'wb'))

if args.makeanimation is not None:
#    try:
        animationfilename = args.makeanimation #'animation_'+datapath.stem+'.mp4'
        print("Saving animation to %s" % animationfilename)
        animation_times = np.arange(np.min(pathi.times),np.max(pathi.times),0.1)
        print(animation_times)
        M,C = pathi.getpredictions(animation_times)
        print(M.shape)
        btinference.makeanimation(animation_times,observations,obstimes,M[:,:3],C[:,:3,:3],animationfilename=animationfilename)
#    except Exception as e:
#        print("Exception occured while generating animation.")
#Generate json point files

#TODO: Need to use before/after for observation selection too!!
##TODO: Could do this selection based on times of observations?


#print("After and Before times:")
#print(after,before)

filenames = []
for fn in sorted(list(datapath.rglob('*.np'))):
    phototime = totalsecs(fn.as_posix())
    if phototime>first_observation_time+interval_start+interval: continue
    if phototime<first_observation_time+interval_start: continue
    if before>=phototime>=after:
        filenames.append(fn)

print("Adding predictions to %d file times" % len(filenames))
#print("Example files...")
#for fn in filenames[::30]:
#    print('/'.join(str(fn).split('/')[-3:]))
#filenames = sorted(list(datapath.rglob('*.np')))
times = np.array([btinference.totalsecsandms(fn.as_posix()) for fn in filenames])

Mobstimes, Cobstimes = pathi.getpredictions(times)

#just get position not velocity...
Mobstimes = Mobstimes[:,:3]
Cobstimes = Cobstimes[:,:3,:3]

print("Saving %d prediction points into json files" % len(Mobstimes))

for fn, t, m, c in zip(filenames,times,Mobstimes,Cobstimes):
    #print("%7.3f %7.3f" % (t-min(times),np.max(np.sqrt(np.diag(c)))))
    #if np.max(np.diag(c))>0.1: continue
    pathparts = fn.parts
    jsonf = pathparts[-1][:-2]+'json'
    camid = pathparts[-2]
    boxid = pathparts[-3]
    camstid = boxid+'/'+camid
    #print(camstid)
    if camstid in cameras:
        cam = cameras[camstid]
        print(m)
        pixelpos = cam.get_pixel_loc(m)[0]   
        jsonfn = Path(*list(pathparts)[:-1]+['btinference']+[jsonf])

        json_items = []
        #json_items.append({"x":int(pixelpos[0]),"y":int(cam.res[1]-pixelpos[1]), "source": "btinference", "version": "btinference, v1.0", "meta":"", "label":"%0.3f" % np.max(np.sqrt(np.diag(c)))})
        
        pixelposes = cam.get_pixel_loc(np.random.multivariate_normal(m,c,100))
        for i,pixelpos in enumerate(pixelposes):
            item = {"x":int(pixelpos[0]),"y":int(cam.res[1]-pixelpos[1]), "source": "btinference", "version": "btinference, v1.0","meta":"", "label":""}
            if i==0: #the first point can store the mean and covariance of the distribution
                item["mean"] = m.tolist()
                item["cov"] = c.tolist()
            json_items.append(item)
        
        Path(jsonfn).parents[0].mkdir(parents=True, exist_ok=True)
        #print(jsonfn)        
        json.dump(json_items,open(jsonfn,'w'))
        

#datapath
jsonfn =Path(datapath,'inference_start%0.0f.json' % interval_start)
test_times = np.arange(np.min(pathi.times),np.max(pathi.times),0.1)
M,C = pathi.getpredictions(test_times)

json_fulldata = []
#json_fulldata = json.load(open(jsonfn,'r'))
for t, m, c in zip(test_times,M,C):
    #just include those within our window!
    if (t>=first_observation_time+interval_start) and (t<first_observation_time+interval_start+interval):
        item = {}
        item["time"] = t
        item["mean"] = m.tolist()
        item["cov"] = c.tolist()
        json_fulldata.append(item)
json.dump(json_fulldata,open(jsonfn,'w'))


pickle.dump({'means':pathi.means,'covs':pathi.covs,'times':pathi.times,'obsfrom':obsfrom},open(inference_cache_fn,"wb"))
